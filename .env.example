# Copier vers .env et remplacer les valeurs. Ne jamais committer .env.
POSTGRES_USER=planning_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=planning
APP_DB_USER=planning_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://planning_app:change-me-app@localhost:5432/planning
MIGRATION_DATABASE_URL=postgresql+psycopg://planning_owner:change-me-owner@localhost:5432/planning
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:3000
# rq = file Redis + worker ; inline = exécution synchrone (tests)
OPT_EXECUTION=rq
# production (défaut) | development | test. Le seed de démonstration est refusé hors development/test.
APP_ENV=development
# Mot de passe des comptes de démo ; laissé vide => généré aléatoirement et affiché une seule fois par le seed
DEMO_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:8000
